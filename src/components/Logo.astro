---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { light }]}>
  <svg class="logo-mark" viewBox="0 0 48 48" width="46" height="46" aria-hidden="true">
    <rect x="1" y="1" width="46" height="46" rx="13" fill={light ? '#ffffff' : '#134786'} />
    <g fill={light ? '#134786' : '#ffffff'}>
      <ellipse cx="17" cy="16.5" rx="3.6" ry="4.6" />
      <ellipse cx="31" cy="16.5" rx="3.6" ry="4.6" />
      <ellipse cx="10.5" cy="25" rx="3.2" ry="4" />
      <ellipse cx="37.5" cy="25" rx="3.2" ry="4" />
      <path d="M24 23.5c-5.6 0-10.5 6.9-10.5 10.6 0 3.2 2.6 4.6 5.4 4.6 2.2 0 3.3-1.1 5.1-1.1s2.9 1.1 5.1 1.1c2.8 0 5.4-1.4 5.4-4.6 0-3.7-4.9-10.6-10.5-10.6Z" />
    </g>
    <path d="M24 28.2v6.6M20.7 31.5h6.6" stroke="#cf95df" stroke-width="2.4" stroke-linecap="round" />
  </svg>
  <span class="logo-text">
    <span class="logo-name">Panemunės</span>
    <span class="logo-sub">veterinarija</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; color: var(--primary); }
  .logo.light { color: #fff; }
  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-name { font-weight: 700; font-size: 1.28rem; letter-spacing: -0.01em; }
  .logo-sub { font-size: .72rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; margin-top: 5px; opacity: .8; }
</style>

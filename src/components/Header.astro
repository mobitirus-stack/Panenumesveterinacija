---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, nav, topbar } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const topActive = (href: string) =>
  href === '/' ? !path.startsWith('/vaistine') && !path.startsWith('/parduotuve') : path.startsWith(href);
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <nav class="divisions" aria-label="Kryptys">
        {topbar.map((t) => <a href={t.href} class:list={{ on: topActive(t.href) }}><span class="full">{t.label}</span><span class="short">{t.short}</span></a>)}
      </nav>
      <div class="topbar-info">
        <span><Icon name="pin" size={14} /> {site.address.street}, {site.address.city}</span>
        <span><Icon name="clock" size={14} /> I–V 10–19, VI 9–15</span>
        <a href={site.mobile.href} class="urgent"><Icon name="alert" size={14} /> Skubi pagalba 24/7</a>
      </div>
    </div>
  </div>
  <div class="mainbar">
    <div class="container mainbar-inner">
      <a href="/" aria-label={`${site.name} – pradžia`}><Logo /></a>
      <nav class="main-nav" aria-label="Pagrindinis meniu">
        <ul>
          {nav.map((n) => <li><a href={n.href} class:list={{ active: isActive(n.href) }}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn-primary btn-pill header-call" href={site.mobile.href}><Icon name="phone" size={16} /> {site.mobile.display}</a>
      <button class="burger" aria-label="Atidaryti meniu" aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu" size={26} /></button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobilus meniu">
      {nav.map((n) => <a href={n.href} class:list={{ active: isActive(n.href) }}>{n.label}</a>)}
      <hr />
      <a href={site.mobile.href} class="btn btn-primary"><Icon name="phone" size={16} /> {site.mobile.display}</a>
      <a href={site.phone.href} class="btn btn-outline"><Icon name="phone" size={16} /> {site.phone.display}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Atidaryti meniu' : 'Uždaryti meniu');
    if (menu) menu.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 50; }
  .topbar { background: var(--primary); color: #fff; font-size: .82rem; }
  .topbar-inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 38px; }
  .divisions { display: flex; }
  .divisions a { padding: 9px 14px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; font-size: .72rem; opacity: .75; border-right: 1px solid rgba(255,255,255,.15); }
  .divisions a:first-child { padding-left: 0; }
  .divisions a:last-child { border-right: 0; }
  .divisions a.on, .divisions a:hover { opacity: 1; color: #f1d6f8; }
  .topbar-info { display: flex; gap: 20px; align-items: center; opacity: .9; }
  .topbar-info span, .topbar-info a { display: inline-flex; align-items: center; gap: 6px; }
  .divisions .short { display: none; }
  .urgent { color: #ffd4f0; font-weight: 600; }
  .mainbar { background: rgba(255,255,255,.95); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); transition: box-shadow .2s; }
  .scrolled .mainbar { box-shadow: 0 6px 24px rgba(18,29,43,.08); }
  .mainbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 74px; }
  .main-nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .main-nav a { display: block; padding: 8px 12px; font-weight: 500; font-size: .96rem; border-radius: 8px; transition: color .15s, background .15s; }
  .main-nav a:hover { color: var(--primary); background: var(--primary-soft); }
  .main-nav a.active { color: var(--primary); font-weight: 600; }
  .burger { display: none; background: none; border: 0; color: var(--primary); cursor: pointer; padding: 6px; }
  .mobile-menu { position: fixed; inset: 112px 0 0 0; background: #fff; overflow-y: auto; padding: 20px; z-index: 49; }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 4px; }
  .mobile-menu nav > a:not(.btn) { padding: 14px 8px; font-size: 1.15rem; font-weight: 500; border-bottom: 1px solid var(--border); }
  .mobile-menu .active { color: var(--primary); }
  .mobile-menu hr { border: 0; margin: 12px 0; }
  .mobile-menu .btn { margin-top: 8px; }
  @media (max-width: 1180px) { .main-nav { display: none; } .burger { display: block; } .header-call { margin-left: auto; } }
  @media (max-width: 900px) { .topbar-info span { display: none; } }
  @media (max-width: 640px) {
    .header-call { display: none; }
    .divisions a { padding: 10px 14px; font-size: .72rem; }
    .divisions .full { display: none; }
    .divisions .short { display: inline; }
    .topbar-info { display: none; }
    .topbar-inner { justify-content: center; }
  }
</style>

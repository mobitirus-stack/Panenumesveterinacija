---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { img } from '../lib/images';
import type { Service } from '../data/services';
interface Props { s: Service; eager?: boolean }
const { s, eager = false } = Astro.props;
const photo = img(s.image);
---
<a href={`/paslaugos/${s.slug}/`} class="svc card reveal">
  <div class="svc-media">
    {photo ? (
      <Image src={photo} alt={s.title} widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <div class="svc-fallback"><Icon name={s.icon} size={64} /></div>
    )}
    <div class="svc-shade"></div>
    <h3>{s.title}</h3>
  </div>
  <div class="svc-body">
    <p>{s.short}</p>
    <div class="chips">
      {s.includes.slice(0, 3).map((i) => <span class="chip">{i}</span>)}
    </div>
    <span class="svc-more">Plačiau <Icon name="arrow" size={16} /></span>
  </div>
</a>

<style>
  .svc { display: flex; flex-direction: column; overflow: hidden; transition: transform .25s, box-shadow .25s; }
  .svc:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .svc-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); }
  .svc-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .svc:hover .svc-media :global(img) { transform: scale(1.05); }
  .svc-fallback { width: 100%; height: 100%; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--primary), #3a6fb0 60%, var(--accent)); }
  .svc-shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(10, 25, 45, .78)); }
  .svc-media h3 { position: absolute; left: 20px; right: 20px; bottom: 16px; margin: 0; color: #fff; font-size: 1.35rem; }
  .svc-body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .svc-body p { color: var(--muted); margin: 0; font-size: .97rem; }
  .svc-more { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--primary); }
</style>

---
interface Props { title: string; lead?: string; eyebrow?: string; crumbs: { name: string; href: string }[] }
const { title, lead, eyebrow, crumbs } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Naršymo kelias">
      {crumbs.map((c, i) => (
        <>
          {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          {i < crumbs.length - 1 && <span aria-hidden="true">/</span>}
        </>
      ))}
    </nav>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

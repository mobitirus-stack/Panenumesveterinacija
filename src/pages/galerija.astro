---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema } from '../lib/schema';
import { img } from '../lib/images';

// Iliustracinės nuotraukos – bus pakeistos tikromis klinikos nuotraukomis.
const crumbs = [{ name: 'Pradžia', href: '/' }, { name: 'Galerija', href: '/galerija/' }];
const items = [
  ['apie-mus', 'Katės apžiūra'],
  ['sunu-vakcinacija', 'Šuniuko vakcinacija'],
  ['kaciu-vakcinacija', 'Katės vakcinacija'],
  ['odontologija', 'Dantų apžiūra'],
  ['mikroschema', 'Mikroschemos žymėjimas'],
  ['apziura', 'Profilaktinė apžiūra'],
  ['odos-ligos', 'Ausų apžiūra'],
  ['erkes', 'Apsauga nuo erkių'],
  ['laboratorija', 'Laboratoriniai tyrimai'],
  ['senas-suo', 'Senjorų priežiūra'],
  ['vaistine', 'Veterinarinė vaistinė'],
  ['mityba', 'Mitybos konsultacija'],
];
const full = await Promise.all(items.map(([n]) => getImage({ src: img(n)!, width: 1400 })));
---
<Base
  title="Galerija | Panemunės veterinarija Kaune"
  description="Panemunės veterinarijos klinikos ir vaistinės Kaune galerija: augintinių apžiūros, vakcinacija, procedūros ir kasdienis darbas."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero title="Galerija" eyebrow="Galerija" lead="Akimirkos iš kasdienio darbo su augintiniais." crumbs={crumbs}>
    <p class="notice"><Icon name="camera" size={18} /> Iliustracinės nuotraukos – klinikos nuotraukos bus įkeltos netrukus.</p>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="gallery">
        {items.map(([n, alt], i) => (
          <button class="g-item reveal" data-full={full[i].src} data-alt={alt} aria-label={`Padidinti: ${alt}`}>
            <Image src={img(n)!} alt={alt} widths={[360, 600]} sizes="(max-width: 640px) 50vw, 380px" loading={i < 6 ? 'eager' : 'lazy'} />
            <span class="cap">{alt}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Nuotraukos peržiūra">
    <button class="lb-close" aria-label="Uždaryti"><Icon name="close" size={28} /></button>
    <img alt="" />
  </dialog>

  <section class="section tight" style="padding-top:0"><div class="container"><CtaBand /></div></section>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const im = dlg.querySelector('img')!;
  document.querySelectorAll<HTMLButtonElement>('.g-item').forEach((b) =>
    b.addEventListener('click', () => { im.src = b.dataset.full!; im.alt = b.dataset.alt!; dlg.showModal(); }),
  );
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as Element).closest('.lb-close')) dlg.close(); });
</script>

<style>
  .notice { margin-top: 20px; display: inline-flex; gap: 10px; align-items: center; color: var(--muted); font-size: .95rem; }
  .gallery { columns: 3 300px; column-gap: 16px; }
  .g-item { display: block; width: 100%; margin: 0 0 16px; padding: 0; border: 0; background: none; cursor: zoom-in; position: relative; border-radius: var(--radius-lg); overflow: hidden; break-inside: avoid; box-shadow: var(--shadow); }
  .g-item :global(img) { width: 100%; transition: transform .5s; }
  .g-item:hover :global(img) { transform: scale(1.04); }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 16px 12px; color: #fff; font-weight: 600; text-align: left; background: linear-gradient(transparent, rgba(10,25,45,.75)); opacity: 0; transition: opacity .25s; }
  .g-item:hover .cap, .g-item:focus-visible .cap { opacity: 1; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 92vw; max-height: 90vh; }
  .lightbox::backdrop { background: rgba(10, 20, 35, .85); }
  .lightbox img { max-width: 92vw; max-height: 86vh; border-radius: 12px; }
  .lb-close { position: fixed; top: 16px; right: 16px; background: rgba(255,255,255,.15); color: #fff; border: 0; border-radius: 50%; width: 48px; height: 48px; display: grid; place-items: center; cursor: pointer; }
</style>

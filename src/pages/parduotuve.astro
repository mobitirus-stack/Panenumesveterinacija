---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

// DEMO vitrina: prekės ir kainos – pavyzdinės, kol klientas pateiks tikrą asortimentą.
const crumbs = [{ name: 'Pradžia', href: '/' }, { name: 'Internetinė parduotuvė', href: '/parduotuve/' }];
const categories = [
  { icon: 'bowl', name: 'Pašarai' },
  { icon: 'shield', name: 'Antiparazitinės priemonės' },
  { icon: 'heart', name: 'Priežiūra ir higiena' },
  { icon: 'tooth', name: 'Dantų priežiūra' },
  { icon: 'pill', name: 'Papildai ir vitaminai' },
  { icon: 'rabbit', name: 'Mažiesiems gyvūnams' },
];
const products = [
  { cat: 'Pašarai', icon: 'bowl', name: 'Sausas pašaras šuniukams', note: 'Įvairių gamintojų, 2–12 kg' },
  { cat: 'Pašarai', icon: 'bowl', name: 'Veterinarinė dieta katėms', note: 'Šlapimo takų, virškinimo, inkstų' },
  { cat: 'Antiparazitinės priemonės', icon: 'shield', name: 'Lašai nuo erkių ir blusų', note: 'Šunims ir katėms pagal svorį' },
  { cat: 'Antiparazitinės priemonės', icon: 'shield', name: 'Tabletės nuo kirmėlių', note: 'Parenkama pagal svorį' },
  { cat: 'Priežiūra ir higiena', icon: 'heart', name: 'Gydomasis šampūnas', note: 'Jautriai odai' },
  { cat: 'Priežiūra ir higiena', icon: 'heart', name: 'Ausų valiklis', note: 'Kasdienei priežiūrai' },
  { cat: 'Dantų priežiūra', icon: 'tooth', name: 'Dantų pasta ir šepetėlis', note: 'Rinkinys šunims ir katėms' },
  { cat: 'Mažiesiems gyvūnams', icon: 'rabbit', name: 'Šienas ir pašaras graužikams', note: 'Triušiams, šinšiloms' },
];
const faq = [
  { q: 'Kaip užsisakyti prekių?', a: `Paskambinkite ${site.phone.display} arba ${site.mobile.display}, arba parašykite ${site.email}. Paruošime prekes atsiėmimui klinikoje Vaidoto g. 97.` },
  { q: 'Ar prekes galima atsiimti klinikoje?', a: 'Taip, užsakytas prekes atsiimsite klinikoje darbo valandomis.' },
  { q: 'Ar galite patarti, kurią priemonę rinktis?', a: 'Žinoma – specialistas padės parinkti tinkamą pašarą ar priemonę pagal augintinio poreikius.' },
];
---
<Base
  title="Internetinė parduotuvė gyvūnams | Panemunės veterinarija"
  description="Pašarai, antiparazitinės, priežiūros ir dantų priemonės gyvūnams. Užsisakykite telefonu ir atsiimkite Panemunės veterinarijoje Kaune, Vaidoto g. 97."
  schema={[breadcrumbSchema(crumbs), faqSchema(faq)]}
>
  <PageHero
    title="Internetinė parduotuvė augintiniams"
    eyebrow="Internetinė parduotuvė"
    lead="Pašarai, antiparazitinės ir priežiūros priemonės – su veterinaro rekomendacija. Užsisakykite telefonu ir atsiimkite klinikoje Panemunėje."
    crumbs={crumbs}
  >
    <div class="notice"><Icon name="bag" size={18} /> Pilna internetinė parduotuvė – netrukus. Kol kas užsakymai priimami telefonu ir el. paštu.</div>
  </PageHero>

  <section class="section tight">
    <div class="container">
      <div class="cats">
        {categories.map((c) => <span class="cat-pill"><Icon name={c.icon} size={18} /> {c.name}</span>)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="grid grid-4">
        {products.map((p) => (
          <div class="product card reveal">
            <div class="p-img"><Icon name={p.icon} size={56} /></div>
            <div class="p-body">
              <span class="p-cat">{p.cat}</span>
              <h2>{p.name}</h2>
              <p class="muted">{p.note}</p>
              <p class="price">Kaina – teiraukitės</p>
              <a class="btn btn-outline btn-pill" href={site.phone.href}>Teirautis</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container steps-wrap">
      <div>
        <span class="eyebrow">Kaip užsisakyti</span>
        <h2>Trys paprasti žingsniai</h2>
      </div>
      <ol class="steps">
        <li><span>1</span><div><h3>Paskambinkite ar parašykite</h3><p class="muted">{site.phone.display} · {site.mobile.display} · {site.email}</p></div></li>
        <li><span>2</span><div><h3>Patikslinsime prekę</h3><p class="muted">Patarsime dėl tinkamiausio pasirinkimo ir patvirtinsime kainą.</p></div></li>
        <li><span>3</span><div><h3>Atsiimkite klinikoje</h3><p class="muted">{site.address.full}, darbo valandomis.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Dažni klausimai</h2>
      <Faq items={faq} />
    </div>
  </section>

  <section class="section tight" style="padding-top:0">
    <div class="container"><CtaBand title="Norite užsisakyti?" text="Paskambinkite – paruošime prekes atsiėmimui." /></div>
  </section>
</Base>

<style>
  .notice { margin-top: 24px; display: inline-flex; gap: 10px; align-items: center; background: #fff; border: 1px dashed var(--accent-dark); color: var(--accent-dark); font-weight: 600; padding: 12px 18px; border-radius: var(--radius); }
  .cats { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .cat-pill { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px; background: #fff; border: 1px solid var(--border); color: var(--primary); font-weight: 600; font-size: .95rem; }
  .product { overflow: hidden; display: flex; flex-direction: column; }
  .p-img { aspect-ratio: 1/0.8; display: grid; place-items: center; color: var(--primary); background: linear-gradient(150deg, var(--primary-soft), #f6eafa); }
  .p-body { padding: 18px 20px 22px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .p-cat { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .p-body h2 { font-size: 1.1rem; margin: 0; }
  .p-body p { margin: 0; font-size: .92rem; }
  .price { font-weight: 700; color: var(--primary); margin-top: auto !important; padding-top: 8px; }
  .p-body .btn { margin-top: 10px; }
  .steps-wrap { display: grid; grid-template-columns: 1fr 1.5fr; gap: 48px; align-items: center; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .steps li { display: flex; gap: 18px; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; }
  .steps li > span { width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; background: var(--primary); color: #fff; display: grid; place-items: center; font-weight: 700; }
  .steps h3 { font-size: 1.1rem; margin-bottom: 2px; }
  .steps p { margin: 0; }
  .narrow { max-width: 860px; }
  @media (max-width: 900px) { .steps-wrap { grid-template-columns: 1fr; } }
</style>
